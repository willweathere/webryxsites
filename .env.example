# ---- Supabase ----
# Supabase Dashboard -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use your publishable key (sb_publishable_...). The classic anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# ---- Email (option A: Gmail app password — works with no domain) ----
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
FROM_NAME=Webryx Sites

# ---- Email (option B: Resend — needs a verified domain) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Webryx Sites <hello@yourdomain.co.uk>

# Where new-lead notifications are sent.
OWNER_EMAIL=you@yourdomain.co.uk
